{
  "name": "dynamic-deployment-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pm2:start": "dotenv -e .env -- pm2 start dist/index.js --name deploy-wizard-backend",
    "pm2:restart": "dotenv -e .env -- pm2 restart deploy-wizard-backend --update-env"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1114.0",
    "@aws-sdk/client-cloudfront": "^3.687.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1112.0",
    "@aws-sdk/client-route-53": "^3.1114.0",
    "@aws-sdk/client-s3": "^3.687.0",
    "adm-zip": "^0.6.0",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^2.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^7.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
